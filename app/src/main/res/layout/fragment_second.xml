<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/rango_cream" tools:context=".SecondFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="220dp"
            android:layout_marginTop="8dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <ImageView android:id="@+id/detail_image" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/recipe_omelet" android:scaleType="centerCrop" android:contentDescription="@string/omelet_title" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/detail_category" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/omelet_category" style="@style/RangoBadge" />
        <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/omelet_title" android:textSize="30sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/rango_text" android:accessibilityHeading="true" />
        <TextView android:id="@+id/detail_description" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/omelet_description" android:textAppearance="@style/RangoBody" android:textColor="@color/rango_muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:orientation="horizontal" android:padding="8dp" android:background="@drawable/bg_badge"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="6dp">
    <TextView android:id="@+id/detail_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/omelet_time" android:textColor="@color/rango_green" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/time_label" android:textAppearance="@style/RangoCaption" android:textSize="11sp" android:gravity="center" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="6dp">
    <TextView android:id="@+id/detail_cost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/omelet_cost" android:textColor="@color/rango_green" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/cost_label" android:textAppearance="@style/RangoCaption" android:textSize="11sp" android:gravity="center" />
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="6dp">
    <TextView android:id="@+id/detail_servings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/omelet_servings" android:textColor="@color/rango_green" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/servings_label" android:textAppearance="@style/RangoCaption" android:textSize="11sp" android:gravity="center" />
</LinearLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp" android:text="@string/ingredients_heading" android:textAppearance="@style/RangoSection" android:accessibilityHeading="true" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/rango_border" app:cardBackgroundColor="@color/rango_surface">
            <LinearLayout android:id="@+id/ingredients_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <include layout="@layout/item_ingredient" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="@string/preparation_heading" android:textAppearance="@style/RangoSection" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" android:text="@string/preparation_caption" android:textAppearance="@style/RangoCaption" />
        <LinearLayout android:id="@+id/preparation_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <include layout="@layout/item_preparation_step" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/cost_note" android:textAppearance="@style/RangoCaption" android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/back_to_recipes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="24dp"
            android:text="@string/back_to_recipes" android:textAllCaps="false" app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

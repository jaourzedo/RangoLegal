<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:orientation="horizontal">
    <TextView android:id="@+id/step_number" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/bg_badge" android:textColor="@color/rango_green" android:textSize="14sp"
        android:fontFamily="sans-serif-medium" android:gravity="center" tools:text="01" />
    <TextView android:id="@+id/step_description" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="14dp" android:textAppearance="@style/RangoBody"
        tools:text="Bata os ovos com o leite, o sal e a pimenta em uma tigela." />
</LinearLayout>
